---
import { Font } from "astro:assets";
---

<!doctype html>
<html lang="en">
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width" />
      <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
      <Font cssVariable="--font-orbitron" />
      <Font cssVariable="--font-cascadia-code" />
      <meta name="generator" content={Astro.generator} />
      <title>Website</title>
    </head>

    <body>
      <div class="triangle-grid">
        <div class="page-shell">
          <slot />
        </div>
      </div>
    </body>
</html>

<style>
    html,
    body {
      margin: 0;
      width: 100%;
      min-height: 100%;
      overflow-x: hidden;
    }

    body {
      position: relative;
    }

    .triangle-grid {
      position: relative;
      isolation: isolate;
      width: 100%;
      min-height: 100vh;
      background: #191a1b;
      overflow: visible;
    }

    .triangle-grid::before {
      content: "";
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100vh;
      z-index: 0;
      pointer-events: none;

      background:
        var(--mouse-trail),
        linear-gradient(180deg, #1d1e1f, #191a1b);

      mask-image:
        repeating-linear-gradient(
          90deg,
      #fff 0,
      #fff 0.2vw,
      transparent 0.2vw,
      transparent 6.05vw,
      #fff 6.05vw,
      #fff 6.25vw
        ),
        repeating-linear-gradient(
          30deg,
      #fff 0,
      #fff 0.2vw,
      transparent 0.2vw,
      transparent 6.05vw,
      #fff 6.05vw,
      #fff 6.25vw
        ),
        repeating-linear-gradient(
          -30deg,
      #fff 0,
      #fff 0.2vw,
      transparent 0.2vw,
      transparent 6.05vw,
      #fff 6.05vw,
      #fff 6.25vw
        );

      mask-composite: add, add;
    }

    .page-shell {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    display: grid;
    place-items: center;
    }

    .orbitron {
      font-family: var(--font-orbitron);
      font-weight: 400;
    }

    .cascadia-code {
      font-family: var(--font-cascadia-code);
      font-weight: 400;
    }
</style>

<script>
    const trailPoints: { x: number; y: number }[] = [];
    const maxTrailPoints = 25;

    function updateTrail(x: number, y: number) {
      trailPoints.push({ x, y });

      if (trailPoints.length > maxTrailPoints) {
        trailPoints.shift();
      }

      const trail = trailPoints
        .map((point, index) => {
          const age = index / Math.max(trailPoints.length - 1, 1);
          const alpha = (1 - age) * 0.8;
          const radius = 18 + age * 60;

          return `radial-gradient(
            circle at ${point.x}px ${point.y}px,
            rgba(64, 90, 116, ${alpha}) 0,
            rgba(64, 90, 116, ${alpha * 0.25}) ${radius}px,
            transparent ${radius + 30}px
          )`;
        })
        .join(", ");

      document.documentElement.style.setProperty("--mouse-trail", trail);
    }

    document.documentElement.style.setProperty(
      "--mouse-trail",
      "radial-gradient(circle at 0 0, transparent 0, transparent 0)"
    );

    document.addEventListener("pointermove", (event) => {
      updateTrail(event.clientX, event.clientY);
    });
</script>