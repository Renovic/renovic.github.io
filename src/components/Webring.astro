---
import PHacker from '../assets/svgs/phacker.svg';
import TriangleArrowLeft from '../assets/svgs/TriangleArrow-Left.svg';
import TriangleArrowRight from '../assets/svgs/TriangleArrow-Right.svg';
---

<nav class="webring" aria-label="Webring navigation">
  <a href="https://ring.purduehackers.com/prev" aria-label="Previous">
    <TriangleArrowLeft class="triangle-arrow" aria-hidden="true" width={14} height={16} />
  </a>
  <a href="https://ring.purduehackers.com/" aria-label="Purdue Hackers Webring">
    <PHacker width={32} height={32} />
  </a>
  <a href="https://ring.purduehackers.com/next" aria-label="Next">
    <TriangleArrowRight class="triangle-arrow" aria-hidden="true" width={14} height={16} />
  </a>
</nav>

<style>
    .webring {
        position: fixed;
        top: 24px;
        right: 24px;
        z-index: 10;

        display: flex;
        align-items: center;
        gap: 4px;
    }

    .webring a {
        display: inline-flex;
        align-items: center;
        color: white;
        fill: white;
        text-decoration: none;
    }

    .webring a:hover {
        fill: #afafaf;
        color: #afafaf;
    }

    .triangle-arrow {
      display: block;
      width: 14px;
      height: 16px;
      filter: invert(1);
    }
</style>