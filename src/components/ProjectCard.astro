---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
    name: string;
    images: ImageMetadata[];
    direction?: 'left' | 'right';
    link: string;
    link_text: string;
    year: string;
}

const {
    name,
    images,
    direction = 'right',
    link,
    link_text,
    year,
} = Astro.props;

const carouselImages = images.filter(Boolean);
const firstImage = carouselImages[0];
---

<div
    class:list={['project-card', `card-${direction}`]}
    data-carousel-images={carouselImages.map((image) => image.src).join('|')}
>
    <div class="project-media">
        <button class="project-trigger" type="button" aria-expanded="false">
        {firstImage && <Image src={firstImage} alt={name} class="project-image" />}
        <span class="project-name">{name}</span>
        </button>

        {carouselImages.length > 1 && (
        <>
            <button class="carousel-button carousel-prev" type="button" aria-label={`Previous ${name} image`}>
            &#9664;
            </button>
            <button class="carousel-button carousel-next" type="button" aria-label={`Next ${name} image`}>
            &#9654;
            </button>
            <div class="carousel-indicators" role="tablist" aria-label={`${name} gallery`}>
            {carouselImages.map((_, index) => (
                <button
                class:list={['carousel-indicator', { 'is-active': index === 0 }]}
                type="button"
                role="tab"
                aria-label={`Show image ${index + 1}`}
                aria-selected={index === 0}
                data-carousel-index={index}
                />
            ))}
            </div>
        </>
        )}
    </div>

    <div class="project-details" hidden>
        <h2>{name}</h2>
        <div class="slot-container">
            <slot />
        </div>
        <div class="project-details-footer">
        <h3 class="project-year">{year}</h3>
        <a href={link} target="_blank" rel="noopener noreferrer">{link_text}</a>
        </div>
    </div>
</div>

<style>
    .project-card {
        position: relative;
        z-index: 0;
        width: calc(50% - var(--horizontal-gap) / 2);
        aspect-ratio: 4 / 3;
        transition:
        width 350ms ease,
        margin 350ms ease,
        transform 150ms ease;
    }

    .project-card.card-right {
        justify-self: end;
    }

    .project-card.card-left {
        justify-self: start;
    }

    .project-card:not(:first-child) {
        margin-top: calc(-1 * var(--vertical-overlap));
    }

    .project-card:hover {
        transform: scale(1.02);
    }

    .project-trigger {
        position: relative;
        display: block;
        width: 100%;
        height: 100%;
        padding: 0;
        border: 0;
        background: rgb(20 20 20 / 0.5);
        border-radius: 20px;
        cursor: pointer;
    }

    .project-media {
        position: relative;
        width: 100%;
        height: 100%;
    }

    .project-trigger::after {
        content: "";
        position: absolute;
        inset: 45% 0 0;
        border-radius: inherit;
        background: linear-gradient(transparent, rgb(0 0 0 / 0.55));
        pointer-events: none;
    }
    
    .project-card.is-open .project-trigger::after {
        display: none;
    }

    .project-image {
        display: block;
        width: 100%;
        height: 100%;
        border-radius: 20px;
        object-fit: cover;
        transition: transform 350ms ease, opacity 350ms ease;
    }

    .project-image.slide-next {
        animation: slide-in-from-right 350ms ease;
    }

    .project-image.slide-prev {
        animation: slide-in-from-left 350ms ease;
    }

    @keyframes slide-in-from-right {
        from {
        opacity: 0;
        transform: translateX(5vw);
        }

        to {
        opacity: 1;
        transform: translateX(0);
        }
    }

    @keyframes slide-in-from-left {
        from {
        opacity: 0;
        transform: translateX(-5vw);
        }

        to {
        opacity: 1;
        transform: translateX(0);
        }
    }

    .project-name {
        position: absolute;
        left: 20px;
        bottom: 20px;
        z-index: 2;
        margin: 0;
        padding: 8px;
        background: rgb(20 20 20 / 0.5);
        border-radius: 10px;
        font-family: var(--font-orbitron);
        color: #ffffff;
        font-size: 1.5rem;
    }

    .project-card.is-open {
        display: flex;
        flex-direction: row;
        width: 100%;
        aspect-ratio: auto;
        margin-top: 40px;
        background: rgb(50 50 50 / 0.5);
        border-radius: 20px;
        overflow: hidden;
        z-index: 1;
    }

    .project-card.is-open .project-name {
        display: none;
    }

    .project-card.is-open .project-image {
        aspect-ratio: 4 / 3;
        width: 100%;
        height: auto;
    }

    .project-card.is-open .project-media {
        flex: 0 0 60%;
        width: 60%;
        height: auto;
        aspect-ratio: 4 / 3;
        margin: 0;
    }

    .project-card.is-open .project-trigger {
        width: 100%;
        height: 100%;
    }

    .project-card.is-open .project-details {
        position: relative;
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        padding: 30px;
        box-sizing: border-box;
    }

    .project-details h2 {
        position: relative;
        width: fit-content;
        margin-bottom: 10px;
        color: transparent;
        font-family: var(--font-orbitron);
        font-size: 1.5rem;
        font-weight: bold;
    }

    .project-details h2::after {
        content: "";
        position: absolute;
        inset: 0;
        background: #27c7e5;
        transform-origin: left;
        transform: scaleX(0);
    }

    .project-card.is-open .project-details h2::after {
        animation: revealProjectTitle 1.2s cubic-bezier(0.77, 0, 0.18, 1) forwards;
    }

    .project-card.is-open .project-details h2 {
        animation: showProjectTitle 1.2s forwards;
    }

    .project-details .slot-container {
        color: #ffffff;
        font-family: var(--font-cascadia-code);
        font-size: 1rem;
    }

    .project-details-footer {
        position: absolute;
        right: 20px;
        bottom: 15px;
        left: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .project-details-footer a {
        color: #ffffff;
        text-decoration: underline;
        font-family: var(--font-cascadia-code);
        font-size: 1rem;
        width: fit-content;
        padding: 8px;
        background: rgb(20 20 20 / 0.5);
        border-radius: 10px;
    }

    .project-details-footer a:hover{
        background: #ffffff;
        color: #000000;
        text-decoration: none;

    }

    .project-year {
        color: #ffffff;
        margin: 0;
        font-family: var(--font-cascadia-code);
        font-size: 1rem;
        width: fit-content;
        padding: 8px;
        background: rgb(20 20 20 / 0.5);
        border-radius: 10px;
    }

    @keyframes revealProjectTitle {
        0% {
            transform: scaleX(0);
        }

        40% {
            transform: scaleX(1);
        }

        100% {
            transform: scaleX(0);
        }
    }

    @keyframes showProjectTitle {
        0%,
        45% {
        color: transparent;
        }

        46%,
        100% {
        color: #27c7e5;
        }
    }

    .project-card.is-open ~ .project-card {
        margin-top: 30px;
    }

    .project-card.card-right.is-open {
        flex-direction: row-reverse;
    }

    .project-card.card-left.is-open {
        flex-direction: row;
    }

    .carousel-button {
        display: none;
        position: absolute;
        top: 50%;
        z-index: 3;
        transform: translateY(-50%);
        width: 42px;
        height: 42px;
        border: 0;
        border-radius: 50%;
        background: rgb(0 0 0 / 0.65);
        color: white;
        cursor: pointer;
    }

    .project-card.is-open .carousel-button {
        display: block;
    }

    .carousel-button:hover {
        background: rgb(0 0 0 / 0.85);
    }

    .carousel-prev {
        left: 16px;
    }

    .carousel-next {
        right: 16px;
    }

    .carousel-indicators {
        display: none;
        position: absolute;
        bottom: 16px;
        left: 50%;
        z-index: 3;
        gap: 7px;
        transform: translateX(-50%);
    }

    .project-card.is-open .carousel-indicators {
        display: flex;
    }

    .carousel-indicator {
        width: 10px;
        height: 10px;
        padding: 0;
        border: 1px solid #ffffff;
        border-radius: 50%;
        background: transparent;
        cursor: pointer;
    }

    .carousel-indicator.is-active {
        background: #ffffff;
    }

    @media (max-width: 600px) {
        .project-card,
        .project-card.is-open {
        width: 100%;
        justify-self: stretch;
        }

        .project-card:not(:first-child) {
        margin-top: 20px;
        }

        .project-card.is-open {
        margin-top: 20px;
        flex-direction: column;
        }

        .project-card.card-right.is-open,
        .project-card.card-left.is-open {
        flex-direction: column;
        }

        .project-card.is-open .project-media {
        flex: none;
        width: 100%;
        height: auto;
        aspect-ratio: auto;
        }

        .project-card.is-open .project-trigger {
        width: 100%;
        height: auto;
        aspect-ratio: auto;
        }

        .project-card.is-open .project-image {
        width: 100%;
        aspect-ratio: 4 / 3;
        }

        .project-card.is-open .project-details {
        width: 100%;
        flex: none;
        padding: 24px;
        box-sizing: border-box;
        }

        .project-card.is-open .project-details-footer {
        position: static;
        margin: 16px 0 0;
        }
    }
</style>

<script>
    const cards = document.querySelectorAll<HTMLElement>('.project-card');

    cards.forEach((card) => {
        const trigger = card.querySelector<HTMLButtonElement>('.project-trigger');
        const details = card.querySelector<HTMLElement>('.project-details');
        const image = card.querySelector<HTMLImageElement>('.project-image');
        const previousButton = card.querySelector<HTMLButtonElement>('.carousel-prev');
        const nextButton = card.querySelector<HTMLButtonElement>('.carousel-next');
        const carouselImages = card.dataset.carouselImages?.split('|').filter(Boolean) ?? [];
        const indicators = card.querySelectorAll<HTMLButtonElement>('.carousel-indicator');
        let imageIndex = 0;

        trigger?.addEventListener('click', () => {
        const isOpen = card.classList.toggle('is-open');

        trigger.setAttribute('aria-expanded', String(isOpen));

        if (details) {
            details.hidden = !isOpen;
        }
        });

        const showImage = (nextIndex: number, direction: 'next' | 'prev') => {
        if (!image || carouselImages.length < 2) return;

        imageIndex = (nextIndex + carouselImages.length) % carouselImages.length;

        image.classList.remove('slide-next', 'slide-prev');
        void image.offsetWidth;

        image.src = carouselImages[imageIndex];
        image.classList.add(direction === 'next' ? 'slide-next' : 'slide-prev');

        indicators.forEach((indicator, index) => {
            const isActive = index === imageIndex;

            indicator.classList.toggle('is-active', isActive);
            indicator.setAttribute('aria-selected', String(isActive));
        });
        };

        previousButton?.addEventListener('click', (event) => {
        event.stopPropagation();
        showImage(imageIndex - 1, 'prev');
        });

        nextButton?.addEventListener('click', (event) => {
        event.stopPropagation();
        showImage(imageIndex + 1, 'next');
        });
    });
</script>
